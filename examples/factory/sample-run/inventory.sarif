{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ZERODAY-Inventory",
          "version": "0.11.0",
          "informationUri": "https://github.com/pandeyaby/ZERODAY",
          "rules": []
        }
      },
      "results": [],
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file:///inventory/"
        }
      },
      "properties": {
        "schemaVersion": "zeroday-factory-inventory/v1",
        "repoCount": 1,
        "findingCount": 0,
        "posture": {
          "localizationOnly": true,
          "notExploitProof": true,
          "noPoC": true,
          "inventoryOnly": true,
          "secretsRedacted": true
        }
      }
    }
  ]
}