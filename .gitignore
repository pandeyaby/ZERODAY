# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (can opt-in for committing if needed)
.env*
# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts
# ZERODAY runtime data
/data/*.db
/data/*.db-*
/data/zeroday-store.json
/data/zeroday-settings.json
!/data/.gitkeep
# Localization reports (keep outside scanned repos)
/zeroday-reports/
# Optional extracted official Antares CLI (gated HF download)
/vendor/antares-cli/
# Local / machine junk
*.log
.idea/
.vscode/
*.swp
