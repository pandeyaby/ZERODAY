{
  "name": "zeroday",
  "version": "0.4.0",
  "private": true,
  "description": "ZERODAY — local-first daily driver for Cisco Foundation AI Antares vulnerability localization",
  "bin": {
    "zeroday": "./cli/index.ts"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint .",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "cli": "tsx cli/index.ts",
    "zeroday": "tsx cli/index.ts",
    "locate": "tsx cli/index.ts locate",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "plinius:init": "mkdir -p vendor/plinius && for r in t3mp3st:T3MP3ST st3gg:ST3GG g0dm0d3:G0DM0D3 cl4r1t4s:CL4R1T4S l1b3rt4s:L1B3RT4S obliteratus:OBLITERATUS; do d=${r%%:*}; u=${r##*:}; if [ ! -d vendor/plinius/$d/.git ]; then git clone --depth 1 https://github.com/elder-plinius/$u.git vendor/plinius/$d; fi; done",
    "plinius:status": "tsx -e \"import { listPliniusStatus } from './src/plinius/registry.ts'; console.log(JSON.stringify(listPliniusStatus(),null,2))\"",
    "plinius:st3gg-deps": "python3 -m venv .venv-st3gg && .venv-st3gg/bin/pip install -r vendor/plinius/st3gg/requirements.txt",
    "export": "tsx cli/index.ts export",
    "draft-fix": "tsx cli/index.ts draft-fix",
    "classify": "tsx cli/index.ts classify",
    "demo": "tsx cli/index.ts demo"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
