    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint .",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:desk": "tsx --test \"tests/desk/**/*.test.ts\"",
    "test:paired-probes": "tsx --test \"tests/locate/paired-probes.test.ts\"",
    "paired-probe": "tsx cli/index.ts paired-probe",
    "cli": "tsx cli/index.ts",
    "zeroday": "tsx cli/index.ts",
    "inventory": "tsx cli/index.ts inventory",
    "packet": "tsx cli/index.ts packet",
    "harden": "tsx cli/index.ts harden",
    "craft": "tsx cli/index.ts craft",
    "skill": "tsx cli/index.ts skill",
    "plugin": "tsx cli/index.ts plugin",
    "mvp": "tsx cli/index.ts mvp",
    "locate": "tsx cli/index.ts locate",
    "operate": "tsx cli/index.ts operate",
    "verify": "tsx cli/index.ts verify",
    "factory": "tsx cli/index.ts factory",
    "quickstart:live": "bash scripts/quickstart-live.sh",
    "demo:proof": "bash scripts/demo-proof.sh",
