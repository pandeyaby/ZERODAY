    "demo:desk:live": "node scripts/desk-ui-live-demo.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "export": "tsx cli/index.ts export",
    "draft-fix": "tsx cli/index.ts draft-fix",
    "classify": "tsx cli/index.ts classify",
    "demo": "tsx cli/index.ts demo"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "lucide-react": "^1.24.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
