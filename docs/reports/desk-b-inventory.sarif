{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ZERODAY-Inventory",
          "version": "0.6.0",
          "informationUri": "https://github.com/pandeyaby/ZERODAY",
          "rules": [
            {
              "id": "ZERODAY-INV-ENV-EXAMPLE",
              "name": "Env example honesty",
              "shortDescription": {
                "text": ".env.example key surface / placeholder honesty"
              },
              "fullDescription": {
                "text": "Inventory reviewed .env.example keys. Values are never exported. Warnings mean a value may not look like a placeholder."
              },
              "properties": {
                "tags": [
                  "security",
                  "inventory",
                  "localization",
                  "env_example_honesty"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "ZERODAY-INV-CI-SECRET-PATTERN",
              "name": "CI secret pattern",
              "shortDescription": {
                "text": "CI workflow references a secret *name* (value not captured)"
              },
              "fullDescription": {
                "text": "Inventory localized a CI secret pattern reference. This is evidence for human review — not proof of exposure or exploitability."
              },
              "properties": {
                "tags": [
                  "security",
                  "inventory",
                  "localization",
                  "ci_secret_pattern"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "ZERODAY-INV-DEP-HARNESS",
              "name": "Dependency harness",
              "shortDescription": {
                "text": "package.json install/remote-shell harness pattern"
              },
              "fullDescription": {
                "text": "Inventory localized a dependency/script harness pattern for human review. Not exploit confirmation. No command body is reproduced."
              },
              "properties": {
                "tags": [
                  "security",
                  "inventory",
                  "localization",
                  "dependency_harness"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "ZERODAY-INV-AGENT-HARNESS",
              "name": "Agent/skill harness",
              "shortDescription": {
                "text": "Agent or skill config mentions an execution/fetch hint"
              },
              "fullDescription": {
                "text": "Inventory localized an agent/skill harness hint. Confirm operator allowlists before live agent use. No PoC."
              },
              "properties": {
                "tags": [
                  "security",
                  "inventory",
                  "localization",
                  "agent_harness"
                ],
                "precision": "medium"
              }
            }
          ]
        }
      },
      "results": [
        {
