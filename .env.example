# Env example (optional — keyless / local-first by default)

# Persistence
ZERODAY_DATA_DIR=./data

# Antares live localization (optional — official CLI + completions endpoint)
# Accept Cisco terms on https://huggingface.co/fdtn-ai/antares-1b first.
# ANTARES_ENDPOINT=http://127.0.0.1:8000/v1
# ANTARES_API_KEY=
# Served model id (required by Antares CLI). ZERODAY defaults to fdtn-ai/antares-1b
# when --endpoint/--live is set if this is unset.
# ANTARES_MODEL=fdtn-ai/antares-1b
# Optional exploration budget for incomplete runs (1–50):
# ANTARES_TOOL_BUDGET=30

# Inference provider (local-first default)
# ZERODAY_INFERENCE_PROVIDER=local
# Opt-in remote CUDA vLLM — recommended host: RunPod (docs/runpod-antares.md)
# Requires ACK — prompts/repo-derived context may leave the machine:
# ZERODAY_INFERENCE_PROVIDER=remote
# ZERODAY_ANTARES_BASE_URL=https://<runpod-proxy-host>/v1
# ZERODAY_ANTARES_API_KEY=
# ZERODAY_REMOTE_INFERENCE_ACK=1
# HF token belongs on the GPU host that loads gated weights (not required for fixture CI)
# HUGGING_FACE_HUB_TOKEN=

# Local UI
# ZERODAY_URL=http://127.0.0.1:3333
# Optional extra path roots for Desk Console sandbox (cwd always allowed).
# Colon / semicolon / comma separated:
# ZERODAY_UI_ROOTS=/path/to/authorized/workspace
