# ZERODAY environment (optional — keyless / local-first by default)

# Persistence
ZERODAY_DATA_DIR=./data

# Antares live localization (official CLI + local endpoint)
# Accept Cisco terms on https://huggingface.co/fdtn-ai/antares-1b first.
# ANTARES_ENDPOINT=http://127.0.0.1:8000/v1/completions
# ANTARES_API_KEY=
# ANTARES_MODEL=

# LLM providers for War Room (optional)
# ZERODAY_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ZERODAY_LOCAL_MODEL=llama3
# OLLAMA_HOST=http://127.0.0.1:11434
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ZERODAY_LLM_API_KEY=

# War Room CLI
# ZERODAY_URL=http://127.0.0.1:3333
