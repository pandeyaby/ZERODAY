# ZERODAY environment (optional — keyless / local-first by default)

# Persistence
ZERODAY_DATA_DIR=./data

# Antares live localization (optional — official CLI + local endpoint)
# Accept Cisco terms on https://huggingface.co/fdtn-ai/antares-1b first.
# ANTARES_ENDPOINT=http://127.0.0.1:8000/v1
# ANTARES_API_KEY=
# Served model id (required by Antares CLI). ZERODAY defaults to fdtn-ai/antares-1b
# when --endpoint/--live is set if this is unset.
# ANTARES_MODEL=fdtn-ai/antares-1b
# Optional exploration budget for incomplete runs (1–50):
# ANTARES_TOOL_BUDGET=30

# Local UI
# ZERODAY_URL=http://127.0.0.1:3333
